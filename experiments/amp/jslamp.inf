[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%Mfg%
CatalogFile=jslamp.cat
DriverVer=10/12/2026,1.0.0.0
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%Disk%

[SourceDisksFiles]
jslamp.sys=1

[Manufacturer]
%Mfg%=Models,NTamd64

[Models.NTamd64]
%Dev%=Install,ACPI\RTL1015

[Install.NT]
CopyFiles=Files

[Files]
jslamp.sys

[Install.NT.Services]
AddService=jslamp,0x2,Svc

[Svc]
DisplayName=%Dev%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\jslamp.sys

[Install.NT.Wdf]
KmdfService=jslamp,Wdf

[Wdf]
KmdfLibraryVersion=1.15

[Strings]
Mfg="Personal"
Disk="JSL amp"
Dev="JSL RT1015P Amp"


