[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Mfg%
CatalogFile=jslaudio.cat
DriverVer=10/12/2026,1.0.0.0
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%Disk%

[SourceDisksFiles]
jslaudio.sys=1
sof-jsl.ri=1

[Manufacturer]
%Mfg%=Models,NTamd64

[Models.NTamd64]
%Dev%=Install,PCI\VEN_8086&DEV_4DC8

[Install.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=Files

[Files]
jslaudio.sys
sof-jsl.ri

[Install.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Wave%,Iface.Wave
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_Wave%,Iface.Wave
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_Wave%,Iface.Wave
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Topology%,Iface.Topo
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_Topology%,Iface.Topo
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveMic%,Iface.WaveMic
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_WaveMic%,Iface.WaveMic
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveMic%,Iface.WaveMic
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologyMic%,Iface.TopoMic
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyMic%,Iface.TopoMic
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveHP%,Iface.WaveHP
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_WaveHP%,Iface.WaveHP
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveHP%,Iface.WaveHP
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologyHP%,Iface.TopoHP
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyHP%,Iface.TopoHP
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveHsMic%,Iface.WaveHsMic
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_WaveHsMic%,Iface.WaveHsMic
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveHsMic%,Iface.WaveHsMic
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologyHsMic%,Iface.TopoHsMic
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyHsMic%,Iface.TopoHsMic

[Iface.WaveHsMic]
AddReg=Iface.WaveHsMic.AddReg

[Iface.WaveHsMic.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%WaveHsMic.Name%

[Iface.TopoHsMic]
AddReg=Iface.TopoHsMic.AddReg

[Iface.TopoHsMic.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%TopoHsMic.Name%

[Iface.WaveHP]
AddReg=Iface.WaveHP.AddReg

[Iface.WaveHP.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%WaveHP.Name%

[Iface.TopoHP]
AddReg=Iface.TopoHP.AddReg

[Iface.TopoHP.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%TopoHP.Name%

[Iface.WaveMic]
AddReg=Iface.WaveMic.AddReg

[Iface.WaveMic.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%WaveMic.Name%

[Iface.TopoMic]
AddReg=Iface.TopoMic.AddReg

[Iface.TopoMic.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%TopoMic.Name%

[Iface.Wave]
AddReg=Iface.Wave.AddReg

[Iface.Wave.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Wave.Name%

[Iface.Topo]
AddReg=Iface.Topo.AddReg

[Iface.Topo.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Topo.Name%

[Install.NT.Services]
AddService=jslaudio,0x2,Svc

[Svc]
DisplayName=%Dev%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\jslaudio.sys

[Strings]
Mfg="Personal"
Disk="JSL audio"
Dev="JSL Speaker (SOF DSP)"
