[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%Mfg%
CatalogFile=jslprobe.cat
DriverVer=10/12/2026,1.0.0.0
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%Disk%

[SourceDisksFiles]
jslprobe.sys=1

[Manufacturer]
%Mfg%=Models,NTamd64

[Models.NTamd64]
%Dev%=Install,PCI\VEN_8086&DEV_4DC8

[Install.NT]
CopyFiles=Files

[Files]
jslprobe.sys

[Install.NT.Services]
AddService=jslprobe,0x2,Svc

[Svc]
DisplayName=%Dev%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\jslprobe.sys

[Install.NT.Wdf]
KmdfService=jslprobe,Wdf

[Wdf]
KmdfLibraryVersion=1.15

[Strings]
Mfg="Personal"
Disk="JSL probe"
Dev="JSL Audio Probe"
